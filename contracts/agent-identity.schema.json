{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://passportkit.local/schemas/agent-identity.schema.json",
  "title": "PassportKit agent identity and behavior contract",
  "description": "Portable definition of who an agent is, what it may do, and which tools it may call. Runtime adapters are outside this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "id", "version", "identity", "behavior", "tools", "io"],
  "properties": {
    "spec": {
      "const": "passportkit.agent/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "role", "domain", "voice"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "determinism",
        "allowedActions",
        "forbiddenActions",
        "onUnknown",
        "onInvalidInput"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1 },
        "determinism": { "const": "fixture-deterministic" },
        "allowedActions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenActions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "onUnknown": { "type": "string", "minLength": 1 },
        "onInvalidInput": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["mock-web-fetch", "notes-store"]
      }
    },
    "io": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 }
      }
    }
  }
}